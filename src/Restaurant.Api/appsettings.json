{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "RestaurantApi",
    "Audience": "RestaurantApi.Clients",
    "ExpiresMinutes": 60
  },
  "RateLimiting": {
    "AuthPermitLimit": 5
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  }
}
